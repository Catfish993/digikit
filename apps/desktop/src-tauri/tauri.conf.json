{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "digikit",
  "version": "0.1.0",
  "identifier": "dev.digiemu.panel",
  "build": {
    "beforeBuildCommand": "pnpm --filter @digi/desktop run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "digikit",
        "width": 1120,
        "height": 1000,
        "minWidth": 700,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
