---
// Shared page shell: top navigation between the emulator and the patch gallery, theme tokens,
// and the COI service worker (GitHub Pages cannot send COOP/COEP headers; the worker adds them so
// SharedArrayBuffer works after the first reload).
import '../styles/site.css';
interface Props {
  title: string;
  active: 'emulator' | 'patch';
}
const { title, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline src={`${base}coi-serviceworker.js`}></script>
  </head>
  <body>
    <nav class="topnav" aria-label="Main">
      <a class="brand" href={base}>
        digikit
      </a>
      <a href={base} aria-current={active === 'emulator' ? 'page' : undefined}>
        Emulator
      </a>
      <a href={`${base}patch`} aria-current={active === 'patch' ? 'page' : undefined}>
        Patch
      </a>
    </nav>
    <slot />
  </body>
</html>
