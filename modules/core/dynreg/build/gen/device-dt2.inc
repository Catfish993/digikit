/* core/dynreg on dt2: generated by `patchkit gen` from the device files and core/machines types.toml; do not edit. */
    .equ DEVICE_ID, 0x1    /* [digikit] id */
    .equ DEVICE_NAME_WORD, 0x64743200    /* [digikit] name, NUL padded, as a big-endian word */
    .equ STORE_FIRST, 0x2df1000    /* [card.store] first_sector */
    .equ STORE_SECTORS, 0x29000    /* [card.store] end_sector - first_sector */
    .equ STORE_HEADER_B, 0x28ffd    /* [card.store] header_b_sector - first_sector (store header copy B, relative to the store) */
    .equ STORE_SEL_A, 0x2e19ffe    /* [card.store] end_sector - 2 (selection record copy A, absolute) */
    .equ STORE_SEL_B, 0x2e19fff    /* [card.store] end_sector - 1 (selection record copy B, absolute) */
    .equ DYN_TYPE_FIRST, 0x10    /* core/machines types.toml dynamic_first */
    .equ DYN_TYPE_LAST, 0x17    /* core/machines types.toml last */
    .equ DYN_TYPES, 0x8    /* run-time machine types; core/dynreg reserves one machine row and core/dyndsp one voice row for each */
    .equ CONSOLE_UART_BASE, 0xec070000    /* [board] console_uart_base */
    .equ DDR_CACHED_BASE, 0x40000000    /* [board] ddr_cached_base */
    .equ DDR_BYTES, 0x8000000    /* [board] ddr_bytes */
    .equ DDR_UNCACHED_ALIAS, 0x48000000    /* [board] ddr_uncached_alias */
    .equ ESDHC_BASE, 0xfc0cc000    /* [board] esdhc_base */
    .equ SAFE_KEY_CODE, 0x13    /* [digikit] safe_key (a panel control code) */
    .equ DSP_BLOCK_CYCLES, 0xa2c2b    /* [board] dsp_clock_hz / dsp_blocks_per_second, rounded (the clock is open, finding 41) */
    .equ DL_AREA_BYTES, 0x80000    /* [digikit] dsp_area_bytes */
    .equ DL_AREA_WORDS, 0x20000    /* [digikit] dsp_area_bytes / 4 */
    .equ DL_TAIL_OFF, 0x804    /* [digikit] dsp_tail_off */
    .equ DL_TAIL_WORDS, 0xae    /* [digikit] dsp_tail_words */
    .equ KEEP_BASE, 0x47fe0000    /* [digikit] keep_base (RAM a soft reset is assumed to keep: the crash record) */
    .equ KEEP_BYTES, 0x1000    /* [digikit] keep_bytes */
    .equ LIMIT_MODULES, 0x8    /* [limits] modules (module records) */
    .equ LIMIT_MACHINE_ROWS, 0x8    /* [limits] machine_rows (run-time machine and voice rows) */
    .equ LIMIT_ARENA_BYTES, 0x80000    /* [limits] arena_bytes (the module arena) */
    .equ LIMIT_FX_SLOTS, 0x3    /* [limits] fx_slots (effects in the chain: CAPACITY's limit and the free effect rows of core/dynfx) */
    .equ LIMIT_STAGE_BYTES, 0x10000    /* [limits] stage_bytes (the staging buffer of a .dkm file) */
    .equ PEEK_N, 0x2    /* [digikit] peek: number of ranges */
    .equ INPUT_BACKEND, 0x1    /* [input] backend (1 panel-uart; 0 none) */
    .equ PANEL_LINEAR, 0x6    /* [panel] linear_channels (code = channel * 8 + bit + 1) */
    .equ PANEL_BUTTON_CHANNELS, 0x7    /* [panel] button_channels (the button decoder's tables: a key channel is below it) */
    .equ PANEL_ENCODERS, 0x9    /* [panel] encoders */
    .equ PANEL_EXC_N, 0x2    /* [panel.exceptions]: number of codes */
    .equ PANEL_EXC_CODE_0, 0x31    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_0, 0x6    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_0, 0x1    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_1, 0x32    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_1, 0x6    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_1, 0x0    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_2, 0x0    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_2, 0x0    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_2, 0x0    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_3, 0x0    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_3, 0x0    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_3, 0x0    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_4, 0x0    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_4, 0x0    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_4, 0x0    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_5, 0x0    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_5, 0x0    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_5, 0x0    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_6, 0x0    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_6, 0x0    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_6, 0x0    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_7, 0x0    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_7, 0x0    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_7, 0x0    /* [panel.exceptions] bit of the code */
    .equ PEEK_LO_0, 0x40000000    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_0, 0x47e30000    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_1, 0x47e8b000    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_1, 0x47fe1000    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_2, 0x0    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_2, 0x0    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_3, 0x0    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_3, 0x0    /* [digikit] peek range end (exclusive) */
